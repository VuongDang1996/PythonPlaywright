# Environment Variables Template
# Copy this file to .env and update values for your environment.

# Core site under test
BASE_URL=https://automationexercise.com

# Browser launch configuration
HEADLESS=true
SLOW_MO_MS=0

# Runtime timeouts (milliseconds)
DEFAULT_TIMEOUT_MS=30000
NAVIGATION_TIMEOUT_MS=60000

# Browser context defaults
VIEWPORT_WIDTH=1280
VIEWPORT_HEIGHT=720
LOCALE=en-US
TIMEZONE_ID=America/New_York
USER_AGENT=
IGNORE_HTTPS_ERRORS=true
ACCEPT_DOWNLOADS=true

# Failure artifact controls
TRACE_ON_FAILURE=true
SCREENSHOT_ON_FAILURE=true
VIDEO_ON_FAILURE=false

# Test account overrides
AE_VALID_USER_EMAIL=your-valid-user@example.com
AE_VALID_USER_PASSWORD=your-valid-password
AE_INVALID_USER_EMAIL=invalid@example.com
AE_INVALID_USER_PASSWORD=wrongpassword
AE_EXISTING_USER_EMAIL=existing@example.com
AE_EXISTING_USER_PASSWORD=password123
